import cv2
import mediapipe as mp
import numpy as np
import time
import os

# ====================== MediaPipe Setup ======================
mp_pose = mp.solutions.pose
mp_drawing = mp.solutions.drawing_utils
mp_drawing_styles = mp.solutions.drawing_styles

def calculate_angle(a, b, c):
    a = np.array([a.x, a.y])
    b = np.array([b.x, b.y])
    c = np.array([c.x, c.y])
    
    radians = np.arctan2(c[1] - b[1], c[0] - b[0]) - np.arctan2(a[1] - b[1], a[0] - b[0])
    angle = np.abs(np.degrees(radians))
    if angle > 180:
        angle = 360 - angle
    return angle


# ==================== FIND YOUR VIDEO PATH ====================
print("Files in /kaggle/input:")
for dirname, _, filenames in os.walk('/kaggle/input'):
    for filename in filenames:
        print(os.path.join(dirname, filename))

# ============== UPDATE THIS PATH AFTER SEEING THE OUTPUT ==============
video_path = "/kaggle/input/datasets/sarangsharma/vid-test/WIN_20260511_23_27_21_Pro.mp4"   # ← CHANGE THIS

cap = cv2.VideoCapture(video_path)

if not cap.isOpened():
    print(f"❌ Still cannot open: {video_path}")
    print("Please copy the correct full path from the list above.")
else:
    print(f"✅ Video successfully opened: {video_path}")
    print(f"Frame width: {int(cap.get(3))}, Height: {int(cap.get(4))}")

# Use lighter settings for Kaggle
pose = mp_pose.Pose(
    static_image_mode=False,
    model_complexity=0,          # Lighter model
    enable_segmentation=False,
    min_detection_confidence=0.6,
    min_tracking_confidence=0.6
)

neck_angles = []
frame_count = 0

print("\nProcessing video...")

while cap.isOpened():
    success, image = cap.read()
    if not success:
        print("✅ End of video reached.")
        break

    frame_count += 1
    image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    results = pose.process(image_rgb)

    if results.pose_landmarks:
        landmarks = results.pose_landmarks.landmark

        nose = landmarks[mp_pose.PoseLandmark.NOSE]
        l_sh = landmarks[mp_pose.PoseLandmark.LEFT_SHOULDER]
        r_sh = landmarks[mp_pose.PoseLandmark.RIGHT_SHOULDER]
        l_hip = landmarks[mp_pose.PoseLandmark.LEFT_HIP]

        mid_shoulder = type('obj', (object,), {
            'x': (l_sh.x + r_sh.x) / 2,
            'y': (l_sh.y + r_sh.y) / 2
        })()

        neck_angle = calculate_angle(nose, mid_shoulder, l_hip)
        cervical_rom = abs(180 - neck_angle)

        neck_angles.append(cervical_rom)
        if len(neck_angles) > 15:
            neck_angles.pop(0)

        avg_rom = sum(neck_angles) / len(neck_angles)

        # Draw
        mp_drawing.draw_landmarks(image, results.pose_landmarks, mp_pose.POSE_CONNECTIONS)

        cv2.putText(image, f"Cervical ROM: {avg_rom:.1f}°", (10, 40),
                    cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2)
    else:
        cv2.putText(image, "No landmarks detected", (10, 40),
                    cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)

    if frame_count % 30 == 0:
        print(f"Frame {frame_count} | Avg ROM: {avg_rom:.1f}°" if neck_angles else f"Frame {frame_count} | No landmarks")

# After the while loop
cap.release()

if neck_angles:
    print("\n" + "="*60)
    print("🎉 PROCESSING COMPLETE")
    print(f"Total frames processed     : {frame_count}")
    print(f"Maximum Cervical ROM       : {max(neck_angles):.1f}°")
    print(f"Minimum Cervical ROM       : {min(neck_angles):.1f}°")
    print(f"Overall Average ROM        : {sum(neck_angles)/len(neck_angles):.1f}°")
    print(f"Movement variability (Std) : {np.std(neck_angles):.1f}°")
    print("="*60)
else:
    print("No landmarks detected.")
